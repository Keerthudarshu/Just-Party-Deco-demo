{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/site/(.*)", "destination": "/$1" },
    { "source": "/asserts/(.*)", "destination": "/assets/$1" },
    { "source": "/public/(.*)", "destination": "/$1" }
  ]
}
